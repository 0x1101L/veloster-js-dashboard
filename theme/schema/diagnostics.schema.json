{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "padding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "right": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "bottom": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "left": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            }
          }
        },
        "alignment": {
          "enum": [
            "start",
            "center",
            "end"
          ]
        }
      }
    }
  }
}
