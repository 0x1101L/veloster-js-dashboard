{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "navigationPosition": {
          "enum": [
            "top",
            "left"
          ]
        },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "padding": {
              "oneOf": [
                { "type": "integer", "minimum": 0, "maximum": 40 },
                { "$ref": "#/$defs/framePadding" }
              ]
            },
            "gap": { "$ref": "#/$defs/regionGap" },
            "cornerShape": { "enum": ["circle", "squircle", "sqircle"], "default": "circle" },
            "cornerRadius": { "type": "integer", "minimum": 0, "maximum": 240, "default": 0 }
          }
        },
        "sideMenuBar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 48, "maximum": 240 },
            "alignment": { "enum": ["start", "center", "end"] },
            "buttonHeight": { "type": "integer", "minimum": 24, "maximum": 50 },
            "padding": { "$ref": "#/$defs/sideMenuPadding" },
            "gap": { "type": "integer", "minimum": 0, "maximum": 40, "description": "Gap between the clock, navigation group, and back button group." },
            "itemGap": { "type": "integer", "minimum": 0, "maximum": 24, "description": "Gap between navigation buttons." },
            "appearance": { "enum": ["buttons", "dock"], "default": "buttons" },
            "presentation": { "enum": ["labels", "icons"], "default": "labels" }
          }
        },
        "topMenuBar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "buttonHeight": { "type": "integer", "minimum": 24, "maximum": 50 },
            "padding": { "$ref": "#/$defs/areaPadding" },
            "itemGap": { "type": "integer", "minimum": 0, "maximum": 40 },
            "presentation": { "enum": ["labels", "icons"], "default": "labels" }
          }
        },
        "contentArea": { "$ref": "#/$defs/paddedArea" },
        "mediaArea": { "$ref": "#/$defs/paddedArea" },
        "bottomMediaBar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "padding": { "$ref": "#/$defs/areaPadding" },
            "itemGap": { "type": "integer", "minimum": 0, "maximum": 40 }
          }
        }
      }
    }
  },
  "$defs": {
    "regionGap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "horizontal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "vertical": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        }
      }
    },
    "areaPadding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": { "type": "integer", "minimum": 0, "maximum": 40 },
        "right": { "type": "integer", "minimum": 0, "maximum": 40 },
        "bottom": { "type": "integer", "minimum": 0, "maximum": 40 },
        "left": { "type": "integer", "minimum": 0, "maximum": 40 },
        "horizontal": { "type": "integer", "minimum": 0, "maximum": 40 },
        "vertical": { "type": "integer", "minimum": 0, "maximum": 40 }
      }
    },
    "framePadding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizontal", "vertical"],
      "properties": {
        "horizontal": { "type": "integer", "minimum": 0, "maximum": 40 },
        "vertical": { "type": "integer", "minimum": 0, "maximum": 40 }
      }
    },
    "sideMenuPadding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vertical": { "type": "integer", "minimum": 0, "maximum": 40 },
        "left": { "type": "integer", "minimum": 0, "maximum": 40 },
        "right": { "type": "integer", "minimum": 0, "maximum": 40 }
      }
    },
    "paddedArea": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "padding": { "$ref": "#/$defs/areaPadding" }
      }
    }
  }
}
